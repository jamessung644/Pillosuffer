# Browser-visible Supabase project configuration. Never use a service role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only credentials. Configure real values in .env.local or Vercel.
GEMINI_API_KEY=
GOOGLE_VISION_API_KEY=
MFDS_API_KEY=

# Leave empty for web; the native app uses its deployed API origin.
NEXT_PUBLIC_API_BASE=
