# Google Cloud Vision API (약 봉투 OCR)
# https://console.cloud.google.com/apis/library/vision.googleapis.com
GOOGLE_VISION_API_KEY=

# Google Gemini API (음식 인식 + 약물 안전 판단 LLM)
# 미설정 시 mock 모드로 동작
GEMINI_API_KEY=

# Supabase (가공식품 DB + 약물 상호작용 DB)
# https://supabase.com/dashboard → 프로젝트 설정 → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 식약처 e약은요 + 의약품 제품허가정보 API
# https://www.data.go.kr/
# data.go.kr 일반 인증키 Decoding 값을 입력하세요.
MFDS_API_KEY=
